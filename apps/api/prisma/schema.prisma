generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  VIEWER
}
enum ContentType {
  ANNOUNCEMENT
  QURAN
  HADITH
  IMAGE
  VIDEO
  RUNNING_TEXT
}
enum AudioCategory {
  ANNOUNCEMENT
  MUROTTAL
  ADHAN
  PRAYER_REMINDER
  GENERAL
}
enum ScheduleType {
  FIXED_TIME
  PRAYER_RELATIVE
}
enum PlayerStatus {
  ONLINE
  OFFLINE
  PLAYING
  ERROR
}
enum TriggerType {
  MANUAL
  SCHEDULE
  PRAYER
}
enum PrayerName {
  FAJR
  DHUHR
  ASR
  MAGHRIB
  ISHA
}
enum PlaybackStatus {
  LOADING
  PLAYING
  FINISHED
  STOPPED
  ERROR
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String?  @unique
  passwordHash String
  role         UserRole @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Mosque {
  agendaSlidesEnabled Boolean @default(true)
  prayerSlideSeconds Int @default(120)
  agendaSlideSeconds Int @default(60)
  id              String   @id @default(cuid())
  name            String
  address         String?
  city            String?
  province        String?
  latitude        Decimal?
  longitude       Decimal?
  timezone        String   @default("Asia/Jakarta")
  logo            String?
  displayLayout   String   @default("classic")
  displayBackground String @default("default")
  displayTheme    String   @default("sapphire")
  runningText     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prayerSettings  PrayerSetting?
  prayerSchedules PrayerSchedule[]
  agendas         Agenda[]
  contents        Content[]
  audios          Audio[]
  players         AudioPlayer[]
}

// Admin-configurable correction (offset) and iqomah durations per prayer, per mosque.
model PrayerSetting {
  id               String   @id @default(cuid())
  mosqueId         String   @unique
  calculationMethod String  @default("MWL") // abstraction hook for PrayerProvider

  fajrOffsetMin    Int @default(0)
  dhuhrOffsetMin   Int @default(0)
  asrOffsetMin     Int @default(0)
  maghribOffsetMin Int @default(0)
  ishaOffsetMin    Int @default(0)

  fajrIqomahMin    Int @default(10)
  dhuhrIqomahMin   Int @default(10)
  asrIqomahMin     Int @default(10)
  maghribIqomahMin Int @default(5)
  ishaIqomahMin    Int @default(10)

  updatedAt        DateTime @updatedAt

  mosque Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)
}

// Cached prayer schedule per date, per mosque. Raw (uncorrected) times from the provider.
model PrayerSchedule {
  cacheKey  String?
  id        String   @id @default(cuid())
  mosqueId  String
  date      DateTime @db.Date
  fajr      String
  sunrise   String?
  dhuhr     String
  asr       String
  maghrib   String
  isha      String
  source    String?
  createdAt DateTime @default(now())

  mosque Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  @@unique([mosqueId, date])
  @@index([mosqueId, date])
}

model Agenda {
  topic String?
  speakerName String?
  speakerRole String?
  audience String?
  invitation String?
  quote String?

  repeatWeekly Boolean @default(false)
  id          String    @id @default(cuid())
  mosqueId    String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mosque Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  @@index([mosqueId, isActive])
}

model Content {
  id           String      @id @default(cuid())
  mosqueId     String
  type         ContentType
  title        String?
  content      String?
  mediaUrl     String?
  displayOrder Int         @default(0)
  durationSeconds Int      @default(10)
  startAt      DateTime?
  endAt        DateTime?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  mosque Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  @@index([mosqueId, type, isActive])
}

model Audio {
  id          String        @id @default(cuid())
  mosqueId    String
  name        String
  description String?
  category    AudioCategory
  filePath    String
  duration    Int?
  fileSize    Int?
  mimeType    String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  mosque    Mosque          @relation(fields: [mosqueId], references: [id], onDelete: Cascade)
  schedules AudioSchedule[]

  @@index([mosqueId, category, isActive])
}

model AudioSchedule {
  id            String       @id @default(cuid())
  audioId       String
  name          String       @default("Schedule")
  scheduleType  ScheduleType
  prayerName    PrayerName?
  offsetMinutes Int?
  resumePlayback Boolean @default(false)
  resumePositionSeconds Float @default(0)
  resumeHistoryId String?
  maxDurationMinutes Int?
  fixedTime     String?
  daysOfWeek    Int[]        @default([0,1,2,3,4,5,6])
  startDate     DateTime?
  endDate       DateTime?
  volume        Int          @default(80)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  audio      Audio             @relation(fields: [audioId], references: [id], onDelete: Cascade)
  executions ScheduleExecution[]

  @@index([isActive, scheduleType])
}

// One row per (scheduleId, plannedDate) guarantees idempotency: the scheduler
// upserts with a unique constraint before dispatching so ticks can never double-fire.
model ScheduleExecution {
  id            String   @id @default(cuid())
  scheduleId    String
  plannedDate   DateTime @db.Date
  plannedTime   String
  status        String   @default("PENDING") // PENDING | DISPATCHED | DONE | FAILED
  createdAt     DateTime @default(now())

  schedule AudioSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, plannedDate])
}

model AudioPlayer {
  id         String       @id @default(cuid())
  mosqueId   String
  name       String
  deviceId   String       @unique
  location   String?
  ipAddress  String?
  status     PlayerStatus @default(OFFLINE)
  volume     Int          @default(80)
  lastSeenAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  mosque Mosque @relation(fields: [mosqueId], references: [id], onDelete: Cascade)

  @@index([mosqueId])
}

model PlaybackHistory {
  id                String         @id @default(cuid())
  playerId          String?
  playerDeviceId    String?
  audioId           String?
  audioName         String?
  scheduleId        String?
  triggerType       TriggerType
  status            PlaybackStatus @default(LOADING)
  plannedAt         DateTime?
  startedAt         DateTime       @default(now())
  finishedAt        DateTime?
  errorMessage      String?
  triggeredByUserId String?

  @@index([startedAt])
  @@index([playerDeviceId])
}



model QuotePlaylist {
  id String @id @default(cuid())
  name String
  audioIds String[]
  times String[]
  daysOfWeek Int[]
  volume Int @default(80)
  isActive Boolean @default(false)
  cycle Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs QuoteRun[]
  approvals QuoteApproval[]
}

model QuoteRun {
  id String @id
  playlistId String
  cycle Int
  slot String
  audioId String?
  selectedAudioId String
  audioName String
  deviceId String
  status String @default("LOADING")
  playedAt DateTime?
  createdAt DateTime @default(now())
  playlist QuotePlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  @@unique([playlistId, slot])
  @@unique([playlistId, cycle, audioId])
}

model QuoteApproval {
  id String @id @default(cuid())
  playlistId String
  cycle Int
  approvedBy String
  approvedAt DateTime @default(now())
  playlist QuotePlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  @@unique([playlistId, cycle])
}